{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "event-asset.pointer.schema.v1",
  "title": "Event Asset Pointer v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["type","anchor_id","version","event_id","created_at","anchors","invariants","signatures"],
  "properties": {
    "type": { "type": "string", "const": "EVENT_ASSET_POINTER" },
    "anchor_id": { "type": "string", "pattern": "^EA-[A-Z0-9-]{3,60}$" },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+$" },
    "event_id": { "type": "string", "minLength": 3, "maxLength": 200 },
    "created_at": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$" },

    "anchors": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pop","third_space"],
      "properties": {
        "pop": {
          "type": "object",
          "additionalProperties": false,
          "required": ["ledger_path","entry_match"],
          "properties": {
            "ledger_path": { "type": "string", "const": "ledger/pop-ledger.log" },
            "entry_match": { "type": "string", "minLength": 3, "maxLength": 300 }
          }
        },
        "third_space": {
          "type": "object",
          "additionalProperties": false,
          "required": ["ledger_path","entry_match"],
          "properties": {
            "ledger_path": { "type": "string", "const": "third-space/decision-ledger.log" },
            "entry_match": { "type": "string", "minLength": 3, "maxLength": 300 }
          }
        }
      }
    },

    "invariants": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": { "type": "string", "pattern": "^[a-z0-9-]{2,64}$" }
    },

    "views": {
      "type": "object",
      "additionalProperties": false,
      "required": ["notes","media_refs","public_caption_ref"],
      "properties": {
        "notes": { "type": ["string","null"], "maxLength": 2000 },
        "media_refs": { "type": "array", "maxItems": 64, "items": { "type": "string", "maxLength": 300 } },
        "public_caption_ref": { "type": ["string","null"], "maxLength": 200 }
      }
    },

    "market_refs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["upad_event_uuid","upad_org_uuid","event_slug"],
      "properties": {
        "upad_event_uuid": { "type": "string", "pattern": "^[0-9a-fA-F-]{36}$" },
        "upad_org_uuid": { "type": "string", "pattern": "^[0-9a-fA-F-]{36}$" },
        "event_slug": { "type": "string", "minLength": 2, "maxLength": 80 }
      }
    },

    "signatures": {
      "type": "object",
      "additionalProperties": false,
      "required": ["human_governor"],
      "properties": {
        "human_governor": { "type": "string", "pattern": "^[A-Za-z0-9_-]{1,32}$" }
      }
    }
  }
}
